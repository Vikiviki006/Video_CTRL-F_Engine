# Virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.py[cod]

# Node / frontend build artefacts
node_modules/
dist/
*.tsbuildinfo

# Environment variables
.env

# IDE
.vscode/
.idea/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# --- Indexed media / derived artefacts ---
# backend/data/ holds uploaded videos, generated keyframe thumbnails and FFmpeg
# clips (MEDIA_ROOT/FRAME_ROOT/CLIP_ROOT resolve relative to the backend CWD, so
# a native run writes there). These are large, regenerable from a re-upload, and
# machine-specific; committing them would add ~90 MB of video to history.


# --- Generated experiment artefacts ---
# These are reproducible from experiments/evaluation/evaluate_retrieval.py and
# the experiments/visualization/plot_*.py scripts. Committing them would put
# multi-megabyte figures in history and invite stale copies being read as
# current results. The source CSVs stay ignored; the directory itself is kept
# via experiments/results/.gitkeep.

# Local bootstrap logs
scripts/*.log
