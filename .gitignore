# --- Generated experiment artefacts ---
# Reproducible from experiments/evaluation/evaluate_retrieval.py and the
# experiments/visualization/plot_*.py scripts, but committed deliberately:
# they are the measured evidence behind the paper (0.6 MB total) and must be
# readable next to the code that produced them. Regenerate rather than hand-edit.

# Local bootstrap logs
scripts/*.log

# --- Uploaded media and derived frames ---
# Large binaries produced by local uploads/ingestion; they live on disk (and in
# PostgreSQL metadata), not in git history.
backend/data/media/
backend/data/frames/
