# VideoCtrl-F Environment Configuration
# Copy to .env and adjust as needed

# ============================================================
# DATABASE
# ============================================================
# PostgreSQL with pgvector extension required
# Docker: postgresql+psycopg2://videocontrol:videocontrol@postgres:5432/videocontrol
# Native: postgresql+psycopg2://videocontrol:videocontrol@localhost:5432/videocontrol
DATABASE_URL=postgresql+psycopg2://videocontrol:videocontrol@localhost:5432/videocontrol

# ============================================================
# MODEL
# ============================================================
# HuggingFace checkpoint for SigLIP-2 (both image and text towers)
MODEL_NAME=google/siglip2-so400m-patch14-384
# HF cache directory
HF_HOME=./data/models

# ============================================================
# STORAGE PATHS (relative to project root for native, /data/... for Docker)
# ============================================================
MEDIA_ROOT=./data/media      # Uploaded videos
FRAME_ROOT=./data/frames     # Keyframe thumbnails
CLIP_ROOT=./data/clips       # Generated clips

# ============================================================
# INDEXING / EXTRACTION SETTINGS
# ============================================================
# Frames per forward pass (lower if OOM)
BATCH_SIZE=8

# Adaptive keyframe extraction thresholds
FRAME_DIFF_THRESHOLD=0.08           # Normalized mean-abs-diff keep threshold
MIN_FRAME_INTERVAL_SECONDS=0.5      # Minimum gap between retained frames
MAX_FRAME_INTERVAL_SECONDS=3.0      # Forced-keep interval

# Upload limit (MB)
MAX_UPLOAD_MB=2048

# Temporal grouping for result de-duplication in /search (seconds)
TEMPORAL_GROUP_WINDOW=3.0

# ============================================================
# CORS & LOGGING
# ============================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ============================================================
# GRAPH & RANKING (Phase 1-2 additions)
# ============================================================

# --- Ranking weights (FinalScore convex combination) ---
# FinalScore = (α·Vector + β·Graph + γ·Temporal + δ·Confidence) / (α+β+γ+δ)
VECTOR_WEIGHT=0.65
GRAPH_WEIGHT=0.20
TEMPORAL_WEIGHT=0.10
CONFIDENCE_WEIGHT=0.05

# --- Bounded graph expansion (HARD caps) ---
GRAPH_MAX_DEPTH=2
GRAPH_MAX_NODES=200

# --- Similarity edges ---
# Minimum measured cosine for SIMILAR_TO edge (strict for precision)
GRAPH_SIMILARITY_THRESHOLD=0.80
# Max SIMILAR_TO edges per frame (highest similarity first)
GRAPH_SIMILAR_TOP_K=5
# Absolute safety cap on edges per video
GRAPH_MAX_EDGES_PER_VIDEO=20000

# --- Temporal & Scene ---
# Temporal proximity scale for scoring (seconds)
TEMPORAL_WINDOW_SECONDS=5.0
# Scene clustering window (seconds)
GRAPH_SCENE_WINDOW_SECONDS=3.0

# --- Candidate pool ---
# Multiplier for top_k when seeding graph expansion
GRAPH_CANDIDATE_MULTIPLIER=3

# --- GraphScore internal coefficients (normalized by sum) ---
GRAPH_DIRECT_COEFF=0.40      # a_d: DirectSimilarity
GRAPH_SCENE_COEFF=0.25       # a_s: SceneOverlap
GRAPH_EDGE_CONF_COEFF=0.20   # a_c: EdgeConfidence
GRAPH_TEMPORAL_COEFF=0.15    # a_t: TemporalAdjacency

# --- Master switches ---
# false = original behaviour exactly (no graph tables written)
GRAPH_ENABLED=true

# Extraction backend ("null" is the only registered one)
# Unknown value = hard error, never silent fallback
GRAPH_EXTRACTOR=null