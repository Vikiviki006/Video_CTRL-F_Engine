# ============================================================
# VideoCtrl-F - Environment Configuration
# Copy to .env and adjust for your machine:  cp .env.example .env
#
# Every value here is a real setting read by app/core/config.py.
# Defaults below are the ones the code falls back to when the variable is
# absent, so an empty .env is a valid (if usually wrong) configuration.
# ============================================================

# --- Database ---
# Native (local PostgreSQL, must have the pgvector extension installed):
DATABASE_URL=postgresql+psycopg2://videocontrol:videocontrol@localhost:5432/videocontrol
# Docker (the pgvector/pgvector:pg16 image bundles the extension):
# DATABASE_URL=postgresql+psycopg2://videocontrol:videocontrol@postgres:5432/videocontrol

# --- Model ---
MODEL_NAME=google/siglip2-so400m-patch14-384
# Where Hugging Face downloads / caches the model
HF_HOME=./data/models

# --- Storage paths (relative to where you run the backend, or absolute) ---
MEDIA_ROOT=./data/media
FRAME_ROOT=./data/frames
CLIP_ROOT=./data/clips

# --- Processing ---
BATCH_SIZE=8
FRAME_DIFF_THRESHOLD=0.08
MIN_FRAME_INTERVAL_SECONDS=0.5
MAX_FRAME_INTERVAL_SECONDS=3.0
MAX_UPLOAD_MB=2048
TEMPORAL_GROUP_WINDOW=3.0

# ============================================================
# Relational graph layer (Phase 1) and graph-aware retrieval (Phase 2)
# All optional; the defaults below are the ones the code uses.
# ============================================================

# Build the relational graph during indexing. Set false to get the original
# behaviour exactly: frames and embeddings only, no graph rows at all.
GRAPH_ENABLED=true

# Which concept/object/text extraction backend to use.
# "null" is the only backend registered in this repository, because no object
# detector, OCR engine, ASR model or captioner exists here. An unknown value is
# a hard error, never a silent fallback to "null".
# See backend/app/services/graph_extraction_service.py.
GRAPH_EXTRACTOR=null

# --- Ranking weights ---
# FinalScore = a*Vector + b*Graph + c*Temporal + d*Confidence, normalised by
# their sum. The defaults sum to 1.00.
VECTOR_WEIGHT=0.65
GRAPH_WEIGHT=0.20
TEMPORAL_WEIGHT=0.10
CONFIDENCE_WEIGHT=0.05

# --- Bounded graph expansion ---
# Both are HARD caps; traversal stops at whichever is reached first.
GRAPH_MAX_DEPTH=2
GRAPH_MAX_NODES=200

# An edge is only written when the MEASURED cosine similarity between two frame
# embeddings is at least this. 0.80 is deliberately strict: the goal is
# high-precision SIMILAR_TO edges, not a dense similarity graph.
GRAPH_SIMILARITY_THRESHOLD=0.80

# Temporal proximity scale (seconds) for the temporal scoring term. Distinct
# from TEMPORAL_GROUP_WINDOW, which controls result de-duplication in /search.
TEMPORAL_WINDOW_SECONDS=5.0

# Scene grouping: retained keyframes within this window of each other are
# clustered into one SCENE node.
GRAPH_SCENE_WINDOW_SECONDS=3.0

# Max SIMILAR_TO edges written per frame (highest measured similarity first).
GRAPH_SIMILAR_TOP_K=5

# Absolute cap on edges written for one video in one indexing run. On reaching
# it the run logs a warning and truncates deterministically rather than growing
# without bound.
GRAPH_MAX_EDGES_PER_VIDEO=20000

# Multiplier on top_k when choosing how many vector candidates to seed graph
# expansion from (mirrors the /search over-fetch).
GRAPH_CANDIDATE_MULTIPLIER=3

# --- Internal coefficients of the GraphScore sub-terms ---
# Normalised by their sum at scoring time, so they need not sum to 1.
# Full formula is documented at the top of
# backend/app/services/graph_ranking_service.py and in README.md.
GRAPH_DIRECT_COEFF=0.40
GRAPH_SCENE_COEFF=0.25
GRAPH_EDGE_CONF_COEFF=0.20
GRAPH_TEMPORAL_COEFF=0.15

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- App ---
LOG_LEVEL=INFO
